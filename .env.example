TS3_SERVER=neverlose.ir
# Empty joins the default channel. Otherwise use a channel path or /123 (channel ID).
TS3_CHANNEL=
TS3_NICKNAME=Music Bot
TS3_SERVER_PASSWORD=
TS3_CHANNEL_PASSWORD=
# Optional: your TS3 unique ID (Settings > Identities > Advanced).
# Only this identity gets administrative commands.
TS3_OWNER_UID=
# Empty lets anyone use music controls. Otherwise comma-separated TS3 unique IDs.
TS3_DJ_UIDS=
